#include <windows.h>
#include <commctrl.h>
#include "resource.h"

1 RT_MANIFEST "mhide.manifest"

IDI_APP ICON "mhide.ico"

IDD_SETTINGS DIALOGEX 0, 0, 230, 112
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "mhide settings"
FONT 9, "Segoe UI", 400, 0, 1
BEGIN
    LTEXT           "Hide the cursor after", IDC_STATIC, 7, 13, 80, 10
    EDITTEXT        IDC_DELAY, 90, 10, 52, 14, ES_NUMBER | ES_AUTOHSCROLL
    CONTROL         "", IDC_DELAY_SPIN, "msctls_updown32",
                    UDS_AUTOBUDDY | UDS_SETBUDDYINT | UDS_ARROWKEYS | UDS_ALIGNRIGHT | UDS_NOTHOUSANDS,
                    0, 0, 11, 14
    LTEXT           "seconds of inactivity", IDC_STATIC, 146, 13, 80, 10

    AUTOCHECKBOX    "&Enabled", IDC_ENABLED, 7, 34, 100, 10
    AUTOCHECKBOX    "&Start with Windows", IDC_AUTOSTART, 7, 49, 140, 10

    LTEXT           "", IDC_STATUS, 7, 68, 216, 10, SS_LEFTNOWORDWRAP

    DEFPUSHBUTTON   "OK", IDOK, 61, 90, 50, 15
    PUSHBUTTON      "Cancel", IDCANCEL, 116, 90, 50, 15
    PUSHBUTTON      "&Apply", IDC_APPLY, 171, 90, 50, 15
END

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "mhide - auto-hide the mouse cursor"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "LegalCopyright", "Copyright (c) 2026 Paul Hindt. MIT License."
            VALUE "InternalName", "mhide"
            VALUE "OriginalFilename", "mhide.exe"
            VALUE "ProductName", "mhide"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
